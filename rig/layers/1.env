# Layer 1: one environment variable. No code change, no rebuild.
NODE_OPTIONS=--require @opentelemetry/auto-instrumentations-node/register
OTEL_EXPORTER_OTLP_ENDPOINT=http://otelcol:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_NODE_RESOURCE_DETECTORS=env,host,os
# runtime-node is OBI's job in this rig (keeps one source of truth for event-loop metrics); fs/dns/net are noise
OTEL_NODE_DISABLED_INSTRUMENTATIONS=runtime-node,fs,dns,net
OTEL_SEMCONV_STABILITY_OPT_IN=http
